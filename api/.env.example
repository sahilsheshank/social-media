# Copy to .env and fill in. Never commit .env.

# MongoDB connection string
MONGO_URL=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority

# Signs login sessions. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional settings
# PORT=8000
# Comma-separated sites allowed to call the API from a browser
# CLIENT_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (set to 1 on most hosts)
# TRUST_PROXY=0
